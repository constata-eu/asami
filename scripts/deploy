#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT_DIR"

scripts/release-builder
forge build

if [ "$(printenv DEPLOY_CONTRACT || echo 0)" = "1" ]; then
  test -n "$ROOTSTOCK_RPC_URL"
  test -n "$DEPLOYER_ADDRESS"
  test -n "$PROXY_ADMIN_ADDRESS"
  test -n "$CONTRACT_OWNER_ADDRESS"
  test -n "$DISBURSEMENT_AUTOMATOR_ADDRESS"
  forge script contract/script/Deploy.s.sol:Deploy \
    --rpc-url "$ROOTSTOCK_RPC_URL" \
    --broadcast \
    --trezor \
    --mnemonic-derivation-paths "m/44'/137'/0'/0/1"
fi

if [ -n "$(printenv DEPLOY_TARGET || true)" ]; then
  scp release/asami "$DEPLOY_TARGET"
fi

echo "Built release/asami. Run 'asami migrate', then use 'asami api' and 'asami worker'."
