        "fileContent": "import { useEffect, useMemo, useState } from \"react\";\nimport logo from \"./assets/logo.svg\";\nimport collective from \"./assets/rootstock_collective.svg\";\n\ntype Member = { id: string; name: string; address: string; score: string };\ntype Asset = { address: string; minimumAmount: string };\ntype Config = {\n  chainId: number;\n  contractAddress: string;\n  explorerUrl: string;\n  contractUrl: string;\n  senderRegistrationUrl: string;\n  xEnglish: string;\n  xSpanish: string;\n};\n\nconst zero = \"0x0000000000000000000000000000000000000000\";\nconst handlePattern = /^@[A-Za-z0-9_]{1,15}$/;\nconst addressPattern = /^0x[0-9a-fA-F]{40}$/;\n\nconst copy = {\n  en: {\n    eyebrow: \"A ROOTSTOCK PRIVATE CLUB\",\n    title: \"Thanking the people who keep Rootstock moving.\",\n    intro: \"Asami is a private club to thank and encourage Rootstock bitcoiners.\",\n    invite: \"Invitation only. Advocate for Rootstock and you'll be let in.\",\n    gift: \"Send a thank-you\",\n    giftText: \"Anyone can airdrop funds to Rootstockers. Send any asset to the club contract and Asami will share it among current members.\",\n    accepted: \"Accepted assets\",\n    minimum: \"Minimum\",\n    contract: \"Club contract\",\n    copy: \"Copy\",\n    copied: \"Copied\",\n    registerText: \"Sending a gift? Register your name directly on the contract, or mention Asami on X with your address and we can register it for you.\",\n    vetted: \"Assets and amounts are vetted to prevent abuse and spam.\",\n    credits: \"With gratitude to\",\n    empty: \"The member list is being synchronized.\",\n    error: \"The club data is temporarily unavailable.\"\n  },\n  es: {\n    eyebrow: \"UN CLUB PRIVADO DE ROOTSTOCK\",\n    title: \"Agradecemos a quienes mantienen Rootstock en movimiento.\",\n    intro: \"Asami es un club privado para agradecer y alentar a los bitcoiners de Rootstock.\",\n    invite: \"Solo por invitación. Defiende Rootstock y te dejaremos entrar.\",\n    gift: \"Envía un agradecimiento\",\n    giftText: \"Cualquiera puede enviar fondos a los Rootstockers. Envía cualquier activo al contrato del club y Asami lo compartirá entre los miembros actuales.\",\n    accepted: \"Activos aceptados\",\n    minimum: \"Mínimo\",\n    contract: \"Contrato del club\",\n    copy: \"Copiar\",\n    copied: \"Copiado\",\n    registerText: \"¿Envías un regalo? Registra tu nombre directamente en el contrato, o menciona a Asami en X con tu dirección para que podamos registrarlo.\",\n    vetted: \"Los activos y los importes se revisan para prevenir abusos y spam.\",\n    credits: \"Con gratitud a\",\n    empty: \"La lista de miembros se está sincronizando.\",\n    error: \"Los datos del club no están disponibles temporalmente.\"\n  }\n} as const;\n\nfunction browserLanguage(): keyof typeof copy {\n  return navigator.language.toLowerCase().startsWith(\"es\") ? \"es\" : \"en\";\n}\n\nexport function App() {\n  const [members, setMembers] = useState<Member[]>([]);\n  const [assets, setAssets] = useState<Asset[]>([]);\n  const [config, setConfig] = useState<Config | null>(null);\n  const [failed, setFailed] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const language = useMemo(browserLanguage, []);\n  const text = copy[language];\n\n  useEffect(() => {\n    Promise.all([\n      fetch(\"/members\").then((response) => checked<Member[]>(response)),\n      fetch(\"/assets\").then((response) => checked<Asset[]>(response)),\n      fetch(\"/config\").then((response) => checked<Config>(response))\n    ])\n      .then(([nextMembers, nextAssets, nextConfig]) => {\n        setMembers(nextMembers);\n        setAssets(nextAssets);\n        setConfig(nextConfig);\n      })\n      .catch(() => setFailed(true));\n  }, []);\n\n  async function copyAddress() {\n    if (!config) return;\n    await navigator.clipboard.writeText(config.contractAddress);\n    setCopied(true);\n    window.setTimeout(() => setCopied(false), 1600);\n  }\n\n  return (\n    <main>\n      <header className=\"hero\">\n        <img className=\"brand-logo\" src={logo} alt=\"Asami\" />\n        <p className=\"eyebrow\">{text.eyebrow}</p>\n        <h1>{text.title}</h1>\n        <p className=\"intro\">{text.intro}</p>\n        <p className=\"invitation\">{text.invite}</p>\n      </header>\n\n      {failed ? <p className=\"notice error\">{text.error}</p> : null}\n\n      <section className=\"members-section\" aria-label=\"Members\">\n        {members.length === 0 && !failed ? <p className=\"notice\">{text.empty}</p> : null}\n        <div className=\"member-grid\">\n          {members.map((member) => (\n            <MemberCard\n              key={member.id}\n              member={member}\n              explorer={config?.explorerUrl}\n            />\n          ))}\n        </div>\n      </section>\n\n      <section className=\"gift-panel\">\n        <div>\n          <p className=\"eyebrow\">{text.gift}</p>\n          <h2>{text.contract}</h2>\n          <p>{text.giftText}</p>\n        </div>\n        {config ? (\n          <div className=\"contract-details\">\n            <a className=\"address\" href={config.contractUrl} target=\"_blank\" rel=\"noreferrer\">\n              {config.contractAddress}\n            </a>\n            <button onClick={copyAddress}>{copied ? text.copied : text.copy}</button>\n          </div>\n        ) : null}\n        <div>\n          <h3>{text.accepted}</h3>\n          <div className=\"assets\">\n            {assets.map((asset) => (\n              <a\n                className=\"asset\"\n                key={asset.address}\n                href={(config?.explorerUrl || \"\") + \"/address/\" + asset.address}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n              >\n                <strong>{asset.address === zero ? \"RBTC\" : shortAddress(asset.address)}</strong>\n                <span>{text.minimum}: {asset.minimumAmount}</span>\n              </a>\n            ))}\n          </div>\n          <p className=\"vetted\">{text.vetted}</p>\n        </div>\n        {config ? (\n          <p className=\"registration\">\n            <a href={config.senderRegistrationUrl} target=\"_blank\" rel=\"noreferrer\">\n              {text.registerText}\n            </a>{\" \"}\n            <a href=\"https://x.com/asami_club\" target=\"_blank\" rel=\"noreferrer\">{config.xEnglish}</a>\n            {\" / \"}\n            <a href=\"https://x.com/asami_club_es\" target=\"_blank\" rel=\"noreferrer\">{config.xSpanish}</a>\n          </p>\n        ) : null}\n      </section>\n\n      <footer>\n        <span>{text.credits}</span>\n        <a className=\"sponsor sponsor-moc\" href=\"https://moneyonchain.com/\" target=\"_blank\" rel=\"noreferrer\">\n          Money on Chain\n        </a>\n        <a className=\"sponsor\" href=\"https://rootstockcollective.xyz/\" target=\"_blank\" rel=\"noreferrer\">\n          <img src={collective} alt=\"Rootstock Collective\" />\n        </a>\n      </footer>\n    </main>\n  );\n}\n\nfunction MemberCard({ member, explorer }: {\n  member: Member;\n  explorer?: string;\n}) {\n  const name = member.name.trim() || member.address;\n  const isHandle = handlePattern.test(name);\n  const isAddress = addressPattern.test(name);\n  const href = isHandle\n    ? \"https://x.com/\" + name.slice(1)\n    : isAddress && explorer\n      ? explorer + \"/address/\" + name\n      : null;\n\n  return (\n    <article className=\"member-card\">\n      <div className=\"avatar\" dangerouslySetInnerHTML={{ __html: identicon(member.address) }} />\n      <h3 className=\"member-name\">\n        {href ? (\n          <a href={href} target=\"_blank\" rel=\"noreferrer\">{name}</a>\n        ) : name}\n      </h3>\n    </article>\n  );\n}\n\nfunction identicon(address: string): string {\n  let hash = 2166136261;\n  for (const character of address.toLowerCase()) {\n    hash ^= character.charCodeAt(0);\n    hash = Math.imul(hash, 16777619);\n  }\n  const hue = Math.abs(hash) % 360;\n  const cells: string[] = [];\n  let state = hash >>> 0;\n  for (let y = 0; y < 5; y += 1) {\n    for (let x = 0; x < 3; x += 1) {\n      state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n      if ((state & 1) === 1) {\n        cells.push('<rect x=\"' + x + '\" y=\"' + y + '\" width=\"1\" height=\"1\"/>');\n        if (x !== 2) cells.push('<rect x=\"' + (4 - x) + '\" y=\"' + y + '\" width=\"1\" height=\"1\"/>');\n      }\n    }\n  }\n  return '<svg viewBox=\"0 0 5 5\" role=\"img\" aria-label=\"Address image\" style=\"color:hsl(' +\n    hue + ' 66% 48%)\"><rect width=\"5\" height=\"5\" fill=\"hsl(' + hue +\n    ' 70% 94%)\"/><g fill=\"currentColor\">' + cells.join(\"\") + \"</g></svg>\";\n}\n\nfunction shortAddress(address: string): string {\n  return address.slice(0, 8) + \"…\" + address.slice(-6);\n}\n\nasync function checked<T>(response: Response): Promise<T> {\n  if (!response.ok) throw new Error(\"request failed\");\n  return response.json() as Promise<T>;\n}\n",
        "scriptKindName": "TSX",
        "projectRootPath": "/work/asami/pwa"
      }
    }
