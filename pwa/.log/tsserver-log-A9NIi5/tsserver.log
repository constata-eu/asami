        "fileContent": "import { useContext, useEffect, useState } from \"react\";\nimport {\n  CoreAdminContext,\n  Form,\n  I18nContext,\n  Notification,\n  SaveButton,\n  TextInput,\n  useDataProvider,\n  useNotify,\n  useRedirect,\n  useTranslate,\n  required,\n} from \"react-admin\";\nimport { publicDataProvider } from \"../lib/data_provider\";\nimport { BareLayout } from \"./layout\";\nimport { Box, Card, CardContent, Container, Skeleton, Stack, Typography } from \"@mui/material\";\nimport { Head1, Lead } from \"../components/theme\";\n\nconst WaitlistFormCard = () => {\n  const t = useTranslate();\n  const notify = useNotify();\n  const redirect = useRedirect();\n  const dataProvider = useDataProvider();\n\n  const onSubmit = async (values: Record<string, any>) => {\n    try {\n      await dataProvider.create(\"WaitlistApplication\", {\n        data: {\n          name: values.name,\n          email: values.email,\n          link1: values.link1,\n          link2: values.link2,\n          link3: values.link3 || null,\n          note: values.note,\n        },\n      });\n      notify(t(\"waitlist.success\"), { type: \"success\" });\n      redirect(\"/login\");\n    } catch (error: any) {\n      notify(error?.message || t(\"waitlist.error\"), { type: \"error\" });\n    }\n  };\n\n  return (\n    <Container maxWidth=\"md\">\n      <Stack gap=\"1em\" my=\"3em\">\n        <Head1>{t(\"waitlist.title\")}</Head1>\n        <Lead>{t(\"waitlist.text\")}</Lead>\n        <Card>\n          <CardContent>\n            <Form sanitizeEmptyValues onSubmit={onSubmit}>\n              <Stack gap=\"0.75em\">\n                <TextInput source=\"name\" label={t(\"waitlist.fields.name\")} validate={required()} fullWidth />\n                <TextInput source=\"email\" label={t(\"waitlist.fields.email\")} type=\"email\" validate={required()} fullWidth />\n                <TextInput source=\"link1\" label={t(\"waitlist.fields.link1\")} validate={required()} fullWidth />\n                <TextInput source=\"link2\" label={t(\"waitlist.fields.link2\")} validate={required()} fullWidth />\n                <TextInput source=\"link3\" label={t(\"waitlist.fields.link3\")} fullWidth />\n                <TextInput\n                  source=\"note\"\n                  label={t(\"waitlist.fields.note\")}\n                  validate={required()}\n                  multiline\n                  minRows={4}\n                  fullWidth\n                />\n                <Box>\n                  <SaveButton label={t(\"waitlist.submit\")} />\n                </Box>\n              </Stack>\n            </Form>\n          </CardContent>\n        </Card>\n        <Typography variant=\"body2\">{t(\"waitlist.review_note\")}</Typography>\n      </Stack>\n    </Container>\n  );\n};\n\nexport default function WaitlistPage() {\n  const [pubDataProvider, setPubDataProvider] = useState<any>(null);\n  const i18nProvider = useContext(I18nContext);\n\n  useEffect(() => {\n    async function initApp() {\n      const prov = await publicDataProvider();\n      setPubDataProvider(prov);\n    }\n    initApp();\n  }, []);\n\n  if (!pubDataProvider) {\n    return (\n      <BareLayout sponsors={false}>\n        <Container maxWidth=\"md\">\n          <Skeleton animation=\"wave\" />\n        </Container>\n      </BareLayout>\n    );\n  }\n\n  return (\n    <BareLayout sponsors={false}>\n      <CoreAdminContext i18nProvider={i18nProvider} dataProvider={pubDataProvider}>\n        <Notification />\n        <WaitlistFormCard />\n      </CoreAdminContext>\n    </BareLayout>\n  );\n}\n",
        "scriptKindName": "TSX",
        "projectRootPath": "/work/asami/pwa"
      }
    }
